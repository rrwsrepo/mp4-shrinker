<Application x:Class="MP4Shrinker.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ThemeMode="System">
 <Application.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,4,12,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,20,5"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/></Style>
 </Application.Resources>
</Application>
